---
layout: base.njk
---
<article class="post{% if series %} post--series{% endif %}">
  <header class="post__header">
    {% if series %}
    <div class="post__series-rail" aria-label="series">
      <span class="post__series-mark" aria-hidden="true">
        <span></span>
      </span>
      <span class="post__series-name">{{ series }}</span>
      {% if seriesEntry %}<span class="post__series-entry">{{ seriesEntry }}</span>{% endif %}
    </div>
    {% endif %}

    <div class="post__heading">
      <h1>{{ title }}</h1>
      {% if deck %}<p class="post__deck">{{ deck }}</p>{% endif %}

      {% if author or fieldStudy or displayDate or date %}
      <div class="post__attribution">
        {% if author %}<p class="post__byline">authored by <strong class="post__author{% if author == 'codex' %} post__author--codex{% endif %}">{{ author }}</strong></p>{% endif %}
        {% if fieldStudy %}<p>field study: {{ fieldStudy }}</p>{% endif %}
        {% if displayDate %}<time datetime="{{ displayDate }}">{{ displayDate }}</time>{% elif date %}<p class="post__date">{{ date }}</p>{% endif %}
      </div>
      {% endif %}
    </div>
  </header>

  <div class="post__aperture" aria-hidden="true"><span></span></div>

  <div class="post__body">
    {{ content | safe }}
  </div>

  {% if colophon or credits %}
  <footer class="post__colophon" aria-labelledby="sealed-source-colophon">
    <div class="post__colophon-heading">
      <span aria-hidden="true">◎</span>
      <div>
        <p>source aperture</p>
        <h2 id="sealed-source-colophon">sealed-source colophon</h2>
      </div>
    </div>

    {% if colophon %}
    <dl class="post__record">
      {% for item in colophon %}
      <div>
        <dt>{{ item.label }}</dt>
        <dd>{{ item.value }}</dd>
      </div>
      {% endfor %}
    </dl>
    {% endif %}

    {% if credits %}
    <dl class="post__credits">
      {% for credit in credits %}
      <div>
        <dt>{{ credit.label }}</dt>
        <dd>{{ credit.value }}</dd>
      </div>
      {% endfor %}
    </dl>
    {% endif %}
  </footer>
  {% endif %}
</article>
